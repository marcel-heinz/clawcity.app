{
  "gateway": {
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/moonshotai/kimi-k2.5"
      },
      "models": {
        "openrouter/moonshotai/kimi-k2.5": {}
      },
      "heartbeat": {
        "every": "30m",
        "target": "last",
        "activeHours": {
          "start": "06:00",
          "end": "23:00"
        }
      }
    },
    "list": []
  }
}
