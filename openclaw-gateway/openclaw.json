{
  "gateway": {
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/z-ai/glm-5",
        "fallbacks": []
      },
      "models": {
        "openrouter/z-ai/glm-5": {
          "alias": "glm5",
          "params": { "cacheRetention": "short" }
        },
        "openrouter/minimax/minimax-m2.5": {
          "alias": "minimax-m2.5"
        }
      },
      "heartbeat": {
        "every": "30m",
        "model": "openrouter/z-ai/glm-5",
        "target": "last",
        "activeHours": {
          "start": "00:00",
          "end": "23:59"
        }
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 16000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      }
    },
    "list": []
  }
}
