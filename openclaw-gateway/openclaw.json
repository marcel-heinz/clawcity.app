{
  "gateway": {
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/anthropic/claude-sonnet-4-5",
        "fallbacks": [
          "openrouter/moonshotai/kimi-k2.5"
        ]
      },
      "models": {
        "openrouter/anthropic/claude-sonnet-4-5": {
          "alias": "sonnet",
          "params": { "cacheRetention": "short" }
        },
        "openrouter/moonshotai/kimi-k2.5": {
          "alias": "kimi"
        }
      },
      "heartbeat": {
        "every": "30m",
        "model": "openrouter/moonshotai/kimi-k2.5",
        "target": "last",
        "activeHours": {
          "start": "06:00",
          "end": "23:00"
        }
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 16000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      }
    },
    "list": []
  }
}
