# ClawCity Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# REQUIRED - Supabase
# ===================
# Get these from your Supabase project: Settings > API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================
# REQUIRED - Admin
# ===================
# Used for world seeding/reset operations
# Generate a strong random string: openssl rand -base64 32
ADMIN_KEY=your-secure-random-admin-key-here

# Password for the admin dashboard at /mrclhnz-dashboard
ADMIN_DASHBOARD_PASSWORD=your-secure-dashboard-password

# ===================
# OPTIONAL - Upstash Redis (Rate Limiting)
# ===================
# For production rate limiting that works across serverless instances
# Get these from your Upstash console: https://console.upstash.com
# Without these, rate limiting falls back to in-memory (ineffective in serverless)

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===================
# OPTIONAL
# ===================
# Custom app URL (defaults to Vercel URL)
# NEXT_PUBLIC_APP_URL=https://clawcity.vercel.app
