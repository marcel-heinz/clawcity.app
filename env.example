# ClawCity Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# SUPABASE
# ===================
# Get these from your Supabase project: Settings > API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================
# ADMIN
# ===================
# Used for world seeding/reset operations
# Generate a strong random string: openssl rand -base64 32
ADMIN_KEY=your-secure-random-admin-key-here

# Password for the admin dashboard at /mrclhnz-dashboard
ADMIN_DASHBOARD_PASSWORD=your-secure-dashboard-password

# ===================
# UPSTASH REDIS (Rate Limiting)
# ===================
# For production rate limiting that works across serverless instances
# Get these from your Upstash console: https://console.upstash.com
# Without these, rate limiting falls back to in-memory (ineffective in serverless)

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===================
# STRIPE (Billing)
# ===================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# ===================
# AGENT ENCRYPTION
# ===================
# 32+ character secret for encrypting agent API keys stored in DB
AGENT_KEY_ENCRYPTION_SECRET=your-32-char-encryption-secret-here

# ===================
# OPENCLAW (Hosted Agent Gateway)
# ===================
# Provisioning server URL and auth token (set on Vercel)
# The gateway itself runs on Railway — see below
OPENCLAW_PROVISION_URL=https://your-openclaw-gateway.example.com
OPENCLAW_PROVISION_TOKEN=your-provision-token
OPENCLAW_INTERNAL_API_TOKEN=shared-internal-token-for-provision-and-app

# ===================
# CRON (Vercel Cron Jobs)
# ===================
CRON_SECRET=your-cron-secret

# ===================
# OPENCLAW GATEWAY (Railway - set in Railway dashboard)
# ===================
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_SOUL_MODEL=z-ai/glm-5   # fallback/default for SOUL generation; live model is managed via Admin -> Railway Settings
# PROVISION_AUTH_TOKEN=your-token
# OPENCLAW_GATEWAY_TOKEN=your-token
# OPENCLAW_CHAT_TIMEOUT_MS=240000
# OPENCLAW_CHAT_RETRIES=2
# OPENCLAW_CHAT_RETRY_DELAY_MS=1500
# OPENCLAW_AUTOPLAY_ENABLED=true
# OPENCLAW_AUTOPLAY_INTERVAL_MS=300000
# OPENCLAW_AUTOPLAY_TIMEOUT_MS=180000
# OPENCLAW_AUTOPLAY_MAX_PARALLEL=2
# OPENCLAW_AUTOPLAY_MAX_AGENTS_PER_TICK=20
# OPENCLAW_AUTOPLAY_PROMPT=optional-custom-autoplay-prompt
# OPENCLAW_MEMORY_DISTILL_EVERY_TICKS=100
# CLAWCITY_API_URL=https://www.clawcity.app
# OPENCLAW_INTERNAL_API_TOKEN=shared-internal-token-for-provision-and-app
